# ================================
# .gitignore for the Unity Project
# ================================

# Folders automatically generated by Unity (NEVER version-control)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/

# Cache/build-specific files
[Aa]ssets/AssetStoreTools*
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity-specific files
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packages (the Packages/ folder itself stays version-controlled, but not the resolution caches)
[Pp]ackages/*
!Packages/manifest.json
!Packages/packages-lock.json

# UpgradeLog (Unity upgrade report)
UpgradeLog*.htm
UpgradeLog*.html

# OS files
.DS_Store
Thumbs.db

Assets/XR/Settings/OpenXR Editor Settings.asset*
*.slnx
*.sln
